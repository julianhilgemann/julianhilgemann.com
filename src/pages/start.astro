---
import Layout from "../layouts/Layout.astro";
import MotionIntro from "../components/MotionIntro.astro";
import NetworkBackdrop from "../components/NetworkBackdrop.astro";
---

<Layout
    title="Start | Julian Hilgemann"
    noHeader={true}
    noFooter={true}
    noAnalytics={true}
    fullWidth={true}
    noTopPadding={true}
>
    <!-- specialized style for this page to handle vertical centering perfectly -->
    <style is:global>
        /* Force main to behave as a flex container for vertical alignment on this page */
        main {
            display: flex !important;
            flex-direction: column;
        }
    </style>

    <MotionIntro />

    <div data-network class="relative isolate flex-1 min-h-[100svh] flex flex-col justify-center px-5 sm:px-8 py-16">
        <NetworkBackdrop />

        <div class="w-full max-w-2xl mx-auto text-center flex flex-col items-center">
            <!-- The greeting rolls between the two languages (src/scripts/gateway.ts);
                 its mask is the outer span. -->
            <h1
                data-greeting
                data-greeting-en="Welcome"
                data-greeting-de="Willkommen"
                data-intro
                class="mt-5 text-5xl sm:text-7xl font-bold tracking-tight leading-[1.1] w-full"
            >
                <span class="block overflow-hidden pb-[0.14em] -mb-[0.14em]"><span data-greeting-word class="inline-block">Welcome</span></span>
            </h1>

            <!-- After the h1 in source (so the generated docs open on it), first on screen. -->
            <p data-intro data-intro-fade class="order-first inline-flex items-center gap-2 text-[11px] sm:text-sm font-medium uppercase tracking-[0.14em] sm:tracking-[0.2em] text-text-secondary text-balance">
                <svg class="hidden sm:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                    <path d="M2 12h20"></path>
                </svg>
                Select a language · Sprache wählen
            </p>

            <nav data-intro data-intro-stagger aria-label="Language · Sprache" class="mt-10 sm:mt-14 grid gap-3 sm:gap-5 sm:grid-cols-2 text-left w-full">
                <a href="/hub" hreflang="en" lang="en" data-lang-card="en" class="link-card glass spotlight-card">
                    <span class="link-icon" aria-hidden="true">{"EN"}</span>
                    <span class="link-text">
                        <span class="link-title">English</span>
                        <span class="link-sub">Continue in English</span>
                    </span>
                    <span class="link-arrow" style="--nx: 4px; --ny: 0px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </span>
                </a>
                <a href="/de/hub" hreflang="de" lang="de" data-lang-card="de" class="link-card glass spotlight-card">
                    <span class="link-icon" aria-hidden="true">{"DE"}</span>
                    <span class="link-text">
                        <span class="link-title">Deutsch</span>
                        <span class="link-sub">Weiter auf Deutsch</span>
                    </span>
                    <span class="link-arrow" style="--nx: 4px; --ny: 0px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </span>
                </a>
            </nav>
        </div>
    </div>
</Layout>

<script>
    import "../scripts/gateway";
</script>
