---
import Layout from "../layouts/Layout.astro";

// Data for the diagram and content to ensure they stay in sync
const layers = [
  {
    id: "foundation",
    label: "FOUNDATION",
    title: "1.0 // FOUNDATION_LAYER",
    specs: [
      { label: "PROTOCOL:", value: "Kimball Dimensional Modeling", utility: "Ensures historical accuracy." },
      { label: "STACK:", value: "PostgreSQL 16", utility: "Acid compliant storage." },
      { label: "LATENCY:", value: "< 50ms", utility: "Optimized for read-heavy loads." }
    ]
  },
  {
    id: "logic",
    label: "LOGIC",
    title: "2.0 // LOGIC_LAYER",
    specs: [
      { label: "TRANSFORM:", value: "dbt Core", utility: "Modular SQL pipelines." },
      { label: "TESTING:", value: "Great Expectations", utility: "Auto-validates data quality." },
      { label: "LINEAGE:", value: "DAG Visualization", utility: "Full traceability." }
    ]
  },
  {
    id: "intelligence",
    label: "INTELLIGENCE",
    title: "3.0 // INTELLIGENCE_LAYER",
    specs: [
      { label: "MODEL:", value: "XGBoost / Prophet", utility: "Predictive analytics." },
      { label: "RUNTIME:", value: "Python 3.11", utility: "Vectorized operations." },
      { label: "OUTPUT:", value: "JSON / Parquet", utility: "High-throughput interchange." }
    ]
  },
  {
    id: "interface",
    label: "INTERFACE",
    title: "4.0 // INTERFACE_LAYER",
    specs: [
      { label: "FRAMEWORK:", value: "Astro + React", utility: "Island architecture." },
      { label: "VISUALS:", value: "D3.js / Recharts", utility: "Custom interactive plots." },
      { label: "RESPONSE:", value: "Edge Cached", utility: "Global availability." }
    ]
  }
];
---

<Layout title="Page Engine | Architecture" fullWidth={true}>
  <!-- 
    Main Wrapper: 
    - Uses negative margin to pull background up behind the fixed header 
  -->
  <div class="bg-background min-h-[100svh] w-full -mt-24 pt-24 md:pt-32 text-ink-muted font-sans font-light relative overflow-x-hidden">
    
    <!-- Background grid effect (optional technical texture) -->
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none" 
         style="background-image: linear-gradient(rgb(var(--color-contrast) / 0.2) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--color-contrast) / 0.2) 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <!-- LEFT COLUMN: Sticky Diagram -->
      <aside class="hidden md:block md:col-span-4 lg:col-span-3 h-[calc(100svh-var(--space-nav))] sticky top-nav">
        <div class="h-full flex flex-col justify-between py-8 border-l border-line pl-8 relative">
          
          <!-- The Pipeline Diagram -->
          <div class="flex flex-col gap-0 relative">
             <!-- Continuous Line Background -->
             <div class="absolute left-[11px] top-4 bottom-4 w-[2px] bg-line -z-10"></div>
             <!-- Traveling packet (animated via JS) -->
             <div id="packet" class="absolute left-[11px] w-[2px] h-12 bg-gradient-to-b from-transparent via-primary to-transparent -z-10 transition-transform ease-linear"></div>

            {layers.map((layer, index) => (
              <div class="diagram-node group flex items-center gap-4 py-8 opacity-40 transition-opacity duration-slow" data-target={layer.id}>
                <!-- Node Dot -->
                <div class="w-[24px] h-[24px] rounded-full border border-line-strong bg-background flex items-center justify-center relative z-10 group-[.active]:border-primary group-[.active]:shadow-[0_0_15px_rgb(var(--color-primary)/0.5)] transition">
                  <div class="w-1.5 h-1.5 rounded-full bg-ink-muted group-[.active]:bg-primary"></div>
                </div>
                <!-- Label -->
                <span class="font-mono text-xs tracking-widest uppercase items-center flex gap-2">
                   { layer.id === 'foundation' && '[RAW]' }
                   { layer.id === 'logic' && '[CLN]' }
                   { layer.id === 'intelligence' && '[MDL]' }
                   { layer.id === 'interface' && '[VIU]' }
                   <span class="hidden lg:inline group-[.active]:text-ink-strong">{layer.label}</span>
                </span>
              </div>
            ))}
          </div>

          <!-- AI Accelerator HUD -->
          <div class="mt-auto rounded-control border border-dashed border-line-strong p-4 bg-wash backdrop-blur-sm relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-contrast/5 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
             <div class="flex items-center gap-3 mb-2">
                <div class="w-2 h-2 rounded-full bg-info animate-pulse"></div>
                <span class="font-mono text-[10px] text-info uppercase tracking-widest">System Online</span>
             </div>
             <div class="font-mono text-xs text-ink-strong">
                ⚡ AI-Augmented<br/>Workflow Active
             </div>
          </div>

        </div>
      </aside>

      <!-- RIGHT COLUMN: Scrollable Specs -->
      <main class="col-span-1 md:col-span-8 lg:col-span-9 flex flex-col gap-32 pb-40 pt-8">
        
        <!-- Page Title -->
        <header class="mb-12">
          <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-ink-strong mb-4">SYSTEM ARCHITECTURE</h1>
          <p class="text-xl text-ink-muted max-w-measure font-light">
            Blueprinting the decision engine. From raw signal ingestion to predictive strategy execution.
          </p>
        </header>
        
        <!-- Mobile Diagram (Horizontal) -->
        <div class="md:hidden flex justify-between items-center mb-12 border-b border-line pb-8 overflow-x-auto whitespace-nowrap gap-4">
             {layers.map((layer) => (
               <div class="flex flex-col items-center gap-2">
                 <div class="w-3 h-3 rounded-full bg-line-strong mobile-node" id={`mobile-node-${layer.id}`}></div>
                 <span class="font-mono text-[10px] text-ink-faint">{layer.label.substring(0,3)}</span>
               </div>
             ))}
        </div>

        {layers.map((layer) => (
            <section id={layer.id} class="spec-section min-h-[50vh] flex flex-col justify-center scroll-mt-nav">
              <!-- Card -->
              <div class="group card p-0 overflow-hidden hover:border-primary/50 transition-colors duration-slow">
                <!-- Glow Effect on Hover -->
                <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-5 transition-opacity duration-slow pointer-events-none"></div>

                <!-- Header -->
                <div class="border-b border-line px-6 py-4 bg-wash flex justify-between items-center">
                  <h2 class="font-mono text-sm md:text-base text-primary tracking-wider">
                     {layer.title}
                  </h2>
                  <div class="hidden sm:block font-mono text-xs text-ink-faint">STATUS: OPTIMIZED</div>
                </div>

                <!-- Content Grid -->
                <div class="p-6 md:p-8">
                   <div class="grid grid-cols-1 gap-y-6">
                      {layer.specs.map((spec) => (
                        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 items-baseline border-b border-line-subtle pb-4 last:border-0 last:pb-0">
                           <div class="sm:col-span-3 font-mono text-xs text-ink-faint uppercase tracking-widest">{spec.label}</div>
                           <div class="sm:col-span-4 font-sans text-base text-ink font-medium">{spec.value}</div>
                           <div class="sm:col-span-5 italic text-sm text-ink-muted">"{spec.utility}"</div>
                        </div>
                      ))}
                   </div>
                </div>
              </div>
            </section>
        ))}

        <!-- Closing CTA -->
        <section class="mt-20 border-t border-line pt-20">
           <div class="font-mono text-sm text-primary mb-4">05.0 // DEPLOYMENT</div>
           <h3 class="text-3xl font-bold text-ink-strong mb-8">Ready to initiate?</h3>
           <a href="#" class="btn btn-solid js-open-contact" data-location="page-engine-cta">
              START PROJECT sequence
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
           </a>
        </section>

      </main>
    </div>
  </div>
</Layout>

<script>
  // Script to handle scrollytelling logic
  document.addEventListener('DOMContentLoaded', () => {
     const sections = document.querySelectorAll('.spec-section');
     const nodes = document.querySelectorAll('.diagram-node');
     const mobileNodes = document.querySelectorAll('.mobile-node');
     const packet = document.getElementById('packet');

     // Helper to updating active state
     const updateActiveState = (id: string) => {
        // Reset
        nodes.forEach(n => {
            n.classList.remove('active'); 
            if (n instanceof HTMLElement) n.style.opacity = '0.4';
        });
        mobileNodes.forEach(n => n.classList.remove('!bg-primary'));

        // Activate
        const activeNode = document.querySelector(`.diagram-node[data-target="${id}"]`);
        if (activeNode && activeNode instanceof HTMLElement) {
            activeNode.classList.add('active');
            activeNode.style.opacity = '1';
            
            // Move packet
            if (activeNode.parentElement) {
                const relativeTop = activeNode.offsetTop;
                if(packet) packet.style.transform = `translateY(${relativeTop + 16}px)`; // Adjusted offset to align better
            }
        }
        
        const mobileNode = document.getElementById(`mobile-node-${id}`);
        if (mobileNode) mobileNode.classList.add('!bg-primary');
     };

     // Intersection Observer
     const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
           if (entry.isIntersecting) {
              const id = entry.target.id;
              updateActiveState(id);
           }
        });
     }, {
        root: null,
        threshold: 0.5, // Trigger when 50% of the section is visible
        rootMargin: "-10% 0px -40% 0px" // Adjust to trigger slightly above center
     });

     sections.forEach(section => observer.observe(section));
  });
</script>

<style>
  /* Custom utility for the shimmer animation */
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
  .animate-shimmer {
    animation: shimmer 2s infinite;
  }
  </style>
