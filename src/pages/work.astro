---
import Layout from "../layouts/Layout.astro";
import SecondaryCTA from "../components/SecondaryCTA.astro";
import MotionIntro from "../components/MotionIntro.astro";
import PageBackdrop from "../components/PageBackdrop.astro";

// Stats, tags and timeline markers only restate the prose in the cards, so
// they live here rather than in literal markup: the llms generator flattens
// literal text into the page docs, where these would read as duplicate copy.
const ui = {
    now: "Now",
    before: "Before",
    fabricStats: [
        { value: 150, label: "customers" },
        { value: 100, label: "tables" },
        { value: 700, label: "measures" },
    ],
    fabricTags: ["Microsoft Fabric", "TMDL", "VS Code", "Git", "DevOps", "Warehouse & Lakehouse"],
    fintechTags: ["Revenue forecasting", "Pipeline forecasting", "Scenario planning", "Metric layer"],
    languages: ["English", "German", "Russian"],
};
---

<Layout
    title="Work | Julian Hilgemann"
    description="Data platform engineer: a multi-tenant Microsoft Fabric product now, production BI and forecasting in fintech before that."
    fullWidth={true}
>
    <MotionIntro />

    <!-- ── Intro ── -->
    <section class="relative isolate px-8 sm:px-12 lg:px-16 pb-16 md:pb-20">
        <PageBackdrop />

        <div class="max-w-[1200px] mx-auto">
            <h1 data-page-title data-intro class="text-5xl md:text-6xl font-bold tracking-tight mb-10">
                Work
            </h1>

            <div class="max-w-2xl text-lg md:text-xl text-text-secondary leading-relaxed space-y-6">
                <p data-intro data-intro-fade class="text-xl md:text-2xl text-text-primary">
                    Two roles, one direction: from the numbers on the surface down
                    into the system that produces them.
                </p>
                <p data-intro data-intro-fade>
                    I'm a data platform engineer in Munich. Microsoft Fabric and
                    Azure at work, containers and DuckDB at home, TouchDesigner
                    after hours. I speak {ui.languages.join(", ")}.
                </p>
            </div>

            <div data-intro data-intro-fade class="mt-10">
                <a
                    data-magnetic
                    href="https://linkedin.com/in/julian-hilgemann"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass hover:bg-white/10 text-white text-sm font-medium py-2.5 px-6 rounded-full transition-colors duration-300 border border-white/10 inline-flex justify-center"
                >
                    LinkedIn
                </a>
            </div>
        </div>
    </section>

    <!-- ── The two roles. The ids are what the Story chapters deep-link into. ── -->
    <section class="px-8 sm:px-12 lg:px-16 py-20 md:py-28 border-t border-white/5">
        <div class="max-w-[1200px] mx-auto grid lg:grid-cols-12 gap-x-16 gap-y-10">
            <div class="lg:col-span-4">
                <h2 data-reveal-lines class="text-3xl md:text-5xl font-bold lg:sticky lg:top-32">
                    What I've built
                </h2>
            </div>

            <div data-timeline class="lg:col-span-8 relative">
                <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10" aria-hidden="true">
                    <div data-timeline-fill class="absolute inset-0 origin-top bg-gradient-to-b from-primary via-primary/60 to-info/60"></div>
                </div>

                <article id="platform" class="relative pl-8 md:pl-12 pb-12 scroll-mt-32">
                    <span data-timeline-dot class="timeline-dot is-lit" aria-hidden="true"></span>
                    <p class="text-xs uppercase tracking-[0.2em] font-semibold text-primary mb-4">{ui.now}</p>
                    <div data-reveal class="glass spotlight-card rounded-2xl p-5 sm:p-6 md:p-8">
                        <h3 class="font-bold text-white text-xl md:text-2xl mb-6">
                            Multi-tenant Fabric product
                        </h3>
                        <div class="grid grid-cols-3 gap-3 pb-6 mb-6 border-b border-white/10" aria-hidden="true">
                            {
                                ui.fabricStats.map((s) => (
                                    <div>
                                        <p class="text-2xl sm:text-3xl md:text-4xl font-bold text-white tabular-nums" data-count={s.value} data-prefix="~">
                                            ~{s.value}
                                        </p>
                                        <p class="text-[10px] sm:text-xs uppercase tracking-wider text-text-secondary mt-1">{s.label}</p>
                                    </div>
                                ))
                            }
                        </div>
                        <p class="text-text-secondary leading-relaxed">
                            I work on the product side of a multi-tenant Microsoft
                            Fabric environment — around 150 customers, each with
                            their own Dev, Test and Prod workspaces. The model runs
                            to roughly 100 tables and 700 measures, and my job is
                            keeping it fast and correct while it keeps growing. I
                            build in VS Code against TMDL files with Git and DevOps
                            behind it, rather than clicking through the service.
                            Alongside that I'm rebuilding the transformation layer,
                            moving dataflows into properly modeled warehouses and
                            lakehouses.
                        </p>
                        <ul class="flex flex-wrap gap-2 mt-6" aria-hidden="true">
                            {
                                ui.fabricTags.map((tag) => (
                                    <li class="text-xs bg-white/5 px-2 py-1 rounded text-text-secondary border border-white/10">{tag}</li>
                                ))
                            }
                        </ul>
                    </div>
                </article>

                <article id="bi" class="relative pl-8 md:pl-12 scroll-mt-32">
                    <span data-timeline-dot class="timeline-dot is-lit" aria-hidden="true"></span>
                    <p class="text-xs uppercase tracking-[0.2em] font-semibold text-info mb-4">{ui.before}</p>
                    <div data-reveal class="glass spotlight-card rounded-2xl p-5 sm:p-6 md:p-8">
                        <h3 class="font-bold text-white text-xl md:text-2xl mb-4">
                            Forecasting and decision models
                        </h3>
                        <p class="text-text-secondary leading-relaxed">
                            Before that I spent years building production BI in
                            fintech: revenue and pipeline forecasting, scenario
                            planning, and the metric layer underneath them — used in
                            rolling executive planning. That side of the work is
                            grounded in formal training in economics and
                            quantitative methods.
                        </p>
                        <ul class="flex flex-wrap gap-2 mt-6" aria-hidden="true">
                            {
                                ui.fintechTags.map((tag) => (
                                    <li class="text-xs bg-white/5 px-2 py-1 rounded text-text-secondary border border-white/10">{tag}</li>
                                ))
                            }
                        </ul>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ── How I work ── -->
    <section class="px-8 sm:px-12 lg:px-16 py-20 md:py-28 border-t border-white/5">
        <div class="max-w-[1200px] mx-auto">
            <h2 data-reveal-lines class="text-3xl md:text-5xl font-bold mb-10 md:mb-14">How I work</h2>
            <ul data-reveal-stagger class="work-list grid md:grid-cols-3 gap-5 md:gap-6">
                <li class="glass spotlight-card rounded-2xl p-7 md:p-8 text-lg text-text-secondary leading-relaxed hover:bg-white/[0.04]">
                    <div class="flex items-center justify-between mb-8" aria-hidden="true">
                        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-info/10 border border-info/20 text-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </span>
                        <span class="work-num text-sm font-semibold tracking-widest text-white/25"></span>
                    </div>
                    <strong class="block text-white text-xl mb-3">Clarity before code.</strong> Architecture
                    follows from a clear picture of what the product is for, not
                    the other way around.
                </li>
                <li class="glass spotlight-card rounded-2xl p-7 md:p-8 text-lg text-text-secondary leading-relaxed hover:bg-white/[0.04]">
                    <div class="flex items-center justify-between mb-8" aria-hidden="true">
                        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-info/10 border border-info/20 text-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                        </span>
                        <span class="work-num text-sm font-semibold tracking-widest text-white/25"></span>
                    </div>
                    <strong class="block text-white text-xl mb-3">Craft in the details.</strong> Correct
                    isn't enough. Naming, layout, load times and edge cases decide
                    whether people come back.
                </li>
                <li class="glass spotlight-card rounded-2xl p-7 md:p-8 text-lg text-text-secondary leading-relaxed hover:bg-white/[0.04]">
                    <div class="flex items-center justify-between mb-8" aria-hidden="true">
                        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-info/10 border border-info/20 text-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                        </span>
                        <span class="work-num text-sm font-semibold tracking-widest text-white/25"></span>
                    </div>
                    <strong class="block text-white text-xl mb-3">Impact you can see.</strong> A dashboard
                    nobody opens is a failed project, however elegant the model.
                </li>
            </ul>
        </div>
    </section>

    <SecondaryCTA />
</Layout>

<script>
    import "../scripts/work";
</script>
