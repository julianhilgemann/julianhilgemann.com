---
import Layout from "../layouts/Layout.astro";
import MotionIntro from "../components/MotionIntro.astro";
import PageBackdrop from "../components/PageBackdrop.astro";
import Projects from "../components/Projects.astro";
import SecondaryCTA from "../components/SecondaryCTA.astro";
---

<Layout
    title="Projects | Julian Hilgemann"
    description="Open-source data projects: analytics engineering, forecasting, data visualisation and creative coding — with the architecture behind each one."
    fullWidth={true}
>
    <MotionIntro />

    <section class="relative isolate px-8 sm:px-12 lg:px-16 pb-20 md:pb-28">
        <PageBackdrop />

        <div class="max-w-[1200px] mx-auto">
            <div class="max-w-3xl mb-12 md:mb-16">
                <h1 data-page-title data-intro class="text-5xl md:text-6xl font-bold tracking-tight mb-8">
                    Projects
                </h1>
                <p data-intro data-intro-fade class="text-xl md:text-2xl text-text-secondary leading-relaxed">
                    A selection of my recent open-source work and public project
                    contributions, hosted on GitHub.
                </p>
            </div>

            <Projects />
        </div>
    </section>

    <SecondaryCTA />
</Layout>

<script>
    import "../scripts/page";
</script>
