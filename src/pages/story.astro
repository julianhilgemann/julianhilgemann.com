---
// The Story moved to hyperadapted.com on 2026-10-25; this page only forwards
// there. Not a `redirects` entry in astro.config.mjs: those meta-refresh,
// which drops the fragment, and a deep link like /story#structure should land
// on its chapter. The script carries the hash over; the meta refresh is for
// visitors without JS. Kept out of the llms docs by SKIP_PAGES.
const TARGET = "https://hyperadapted.com/story/";
const FORWARD = `${TARGET}?utm_source=julianhilgemann&utm_medium=referral&utm_campaign=julianhilgemann-site&utm_content=story-redirect`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>The Story now lives on hyperadapted.com</title>
        <meta name="robots" content="noindex" />
        <link rel="canonical" href={TARGET} />
        <script is:inline define:vars={{ FORWARD }}>
            location.replace(FORWARD + location.hash);
        </script>
        <meta http-equiv="refresh" content={`0;url=${FORWARD}`} />
    </head>
    <body>
        <a href={FORWARD}>The Story now lives on hyperadapted.com</a>
    </body>
</html>
