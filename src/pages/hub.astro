---
import Layout from "../layouts/Layout.astro";
import MotionIntro from "../components/MotionIntro.astro";
import NetworkBackdrop from "../components/NetworkBackdrop.astro";
---

<Layout
    title="Hub | Julian Hilgemann"
    noHeader={true}
    noTopPadding={true}
    fullWidth={true}
>
    <!-- specialized style for this page to handle vertical centering perfectly -->
    <style is:global>
        /* Force main to behave as a flex container for vertical alignment on this page */
        main {
            display: flex !important;
            flex-direction: column;
        }
    </style>

    <MotionIntro />

    <div data-network class="relative isolate flex-1 min-h-[100svh] flex flex-col justify-center px-5 sm:px-8 py-16 sm:py-24">
        <NetworkBackdrop />

        <div class="w-full max-w-3xl mx-auto">
            <header class="text-center mb-10 sm:mb-14">
                <h1 data-page-title data-intro class="text-4xl sm:text-6xl font-bold tracking-tight leading-[1.1]">
                    Julian <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-yellow-300">Hilgemann</span>
                </h1>
                <p data-intro data-intro-fade class="mt-4 text-base sm:text-lg text-text-secondary text-balance">
                    Power BI & Microsoft Fabric decision systems
                </p>
            </header>

            <nav data-intro data-intro-stagger aria-label="Links" class="grid gap-3 sm:gap-5 sm:grid-cols-2">
                <!-- Homepage -->
                <a href="/" class="link-card is-primary glass spotlight-card">
                    <span class="link-icon">
                        <svg class="fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"></path>
                        </svg>
                    </span>
                    <span class="link-text">
                        <span class="link-title">Homepage</span>
                        <span class="link-sub">Main Website</span>
                    </span>
                    <span class="link-arrow" style="--nx: 4px; --ny: 0px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </span>
                </a>

                <!-- GitHub -->
                <a href="https://github.com/julianhilgemann" target="_blank" rel="noopener noreferrer" class="link-card glass spotlight-card">
                    <span class="link-icon">
                        <svg class="fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 .297a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58l-.01-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.67 1.65.25 2.87.12 3.17.78.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.69.82.57A12 12 0 0 0 12 .297z"></path>
                        </svg>
                    </span>
                    <span class="link-text">
                        <span class="link-title">GitHub</span>
                        <span class="link-sub">Code & Projects</span>
                    </span>
                    <span class="link-arrow" style="--nx: 3px; --ny: -3px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
                    </span>
                </a>

                <!-- LinkedIn -->
                <a href="https://linkedin.com/in/julian-hilgemann" target="_blank" rel="noopener noreferrer" class="link-card glass spotlight-card">
                    <span class="link-icon">
                        <svg class="fill-current" viewBox="0 0 310 310" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M72.16,99.73H9.927c-2.762,0-5,2.239-5,5v199.928c0,2.762,2.238,5,5,5H72.16c2.762,0,5-2.238,5-5V104.73C77.16,101.969,74.922,99.73,72.16,99.73z"></path>
                            <path d="M41.066,0.341C18.422,0.341,0,18.743,0,41.362C0,63.991,18.422,82.4,41.066,82.4c22.626,0,41.033-18.41,41.033-41.038C82.1,18.743,63.692,0.341,41.066,0.341z"></path>
                            <path d="M230.454,94.761c-24.995,0-43.472,10.745-54.679,22.954V104.73c0-2.761-2.238-5-5-5h-59.599c-2.762,0-5,2.239-5,5v199.928c0,2.762,2.238,5,5,5h62.097c2.762,0,5-2.238,5-5v-98.918c0-33.333,9.054-46.319,32.29-46.319c25.306,0,27.317,20.818,27.317,48.034v97.204c0,2.762,2.238,5,5,5H305c2.762,0,5-2.238,5-5V194.995C310,145.43,300.549,94.761,230.454,94.761z"></path>
                        </svg>
                    </span>
                    <span class="link-text">
                        <span class="link-title">LinkedIn</span>
                        <span class="link-sub">Connect & Network</span>
                    </span>
                    <span class="link-arrow" style="--nx: 3px; --ny: -3px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
                    </span>
                </a>

                <!-- Contact (vCard) -->
                <a href="/Julian_Hilgemann.vcf" download="Julian_Hilgemann.vcf" class="link-card glass spotlight-card">
                    <span class="link-icon">
                        <svg class="fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm-8 4c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm4.5 8H7v-.95c0-1.38 2.38-2.05 5-2.05s5 .67 5 2.05V16z"></path>
                        </svg>
                    </span>
                    <span class="link-text">
                        <span class="link-title">Contact</span>
                        <span class="link-sub">Save to contacts</span>
                    </span>
                    <span class="link-arrow" style="--nx: 0px; --ny: 3px">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"></path></svg>
                    </span>
                </a>
            </nav>
        </div>
    </div>
</Layout>

<script>
    import "../scripts/gateway";
</script>
