---
import MotionIntro from "./MotionIntro.astro";
import GradientSheet from "./GradientSheet.astro";
---

<section
    id="hero"
    data-hero
    class="min-h-[100svh] pt-24 pb-20 md:py-0 flex flex-col justify-center relative isolate overflow-hidden"
>
    <MotionIntro />

    <!-- ========================================== -->
    <!-- LAYER 1: Gradient sheet (Deepest)          -->
    <!-- ========================================== -->
    <GradientSheet intro class="-z-40" />

    <!-- ========================================== -->
    <!-- LAYER 2: Global Glass Layer (-z-20)        -->
    <!-- Tints and softens the gradient             -->
    <!-- ========================================== -->
    <div class="absolute inset-0 bg-background/20 backdrop-blur-[5px] pointer-events-none -z-20"></div>

    <!-- ========================================== -->
    <!-- LAYER 3: Content & Buttons (Top, z-10)     -->
    <!-- ========================================== -->
    <div
        data-hero-content
        class="page-container relative z-10 pointer-events-none"
    >
        <div class="max-w-3xl">
            <h1
                data-hero-title
                data-intro
                class="text-display text-ink-strong mb-6 md:mb-8"
            >
                <!-- nowrap: a line may break after an inline-block, which
                     left the full stop alone on a line at 375px. -->
                I build the systems between a measurement and a <span class="whitespace-nowrap"><span
                    data-accent
                    class="inline-block tabular-nums text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-glow"
                    >decision</span
                >.</span>
            </h1>

            <p
                data-hero-fade
                data-intro
                class="text-lead text-ink drop-shadow-md mb-8 md:mb-10 max-w-measure"
            >
                Data platform engineer in Munich. Microsoft Fabric at work,
                containers and DuckDB at home, TouchDesigner after hours.
            </p>

            <div data-hero-fade data-intro class="flex pointer-events-auto">
                <a
                    href="/projects"
                    class="btn btn-primary"
                >
                    Projects
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll cue. Below md it sits in the hero's bottom padding (py-28),
         so it never overlaps the content on a short phone. -->
    <a
        href="#now-building"
        data-scroll-cue
        data-intro
        aria-label="Scroll to what I'm building now"
        class="flex absolute bottom-5 md:bottom-10 inset-x-0 mx-auto w-10 h-12 md:h-16 items-start justify-center z-10 group"
    >
        <span class="relative block w-px h-10 md:h-14 bg-line-strong overflow-hidden group-hover:bg-ink-faint transition-colors">
            <span class="scroll-cue-dot absolute left-0 top-0 w-px h-5 bg-gradient-to-b from-transparent to-primary"></span>
        </span>
    </a>
</section>

<style>
    @keyframes scroll-cue {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(300%);
        }
    }
    .scroll-cue-dot {
        animation: scroll-cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .scroll-cue-dot {
            animation: none;
        }
    }
</style>

