---
import MotionIntro from "./MotionIntro.astro";
import GradientSheet from "./GradientSheet.astro";
import ScrollCue from "./ScrollCue.astro";

// What a measurement can end in: the headline's last words take turns
// (home.ts). "a decision." is literal markup, so it is what no-JS and
// reduced-motion visitors see and what the generated docs read; the rest
// travel as an expression and stay out of the docs.
const outcomes = [
    ["a", "forecast"],
    ["an", "analysis"],
    ["an", "action"],
    ["a", "strategy"],
    ["a", "diagnosis"],
    ["a", "budget"],
    ["a", "dashboard"],
    ["an", "insight"],
    ["a", "price"],
    ["a", "plan"],
    ["an", "audit"],
    ["an", "answer"],
];
const accent = "text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-glow";
---

<section
    id="hero"
    data-hero
    class="min-h-[100svh] pt-24 pb-20 md:py-0 flex flex-col justify-center relative isolate overflow-hidden"
>
    <MotionIntro />

    <!-- ========================================== -->
    <!-- LAYER 1: Gradient sheet (Deepest)          -->
    <!-- ========================================== -->
    <GradientSheet intro class="-z-40" />

    <!-- ========================================== -->
    <!-- LAYER 2: Global Glass Layer (-z-20)        -->
    <!-- Tints and softens the gradient             -->
    <!-- ========================================== -->
    <!-- No blur below md: on a phone, re-blurring a full-screen canvas every
         frame costs scroll smoothness, and the canvas is soft already. -->
    <div class="absolute inset-0 bg-background/20 md:backdrop-blur-[5px] pointer-events-none -z-20"></div>

    <!-- ========================================== -->
    <!-- LAYER 3: Content & Buttons (Top, z-10)     -->
    <!-- ========================================== -->
    <div
        data-hero-content
        class="page-container relative z-10 pointer-events-none"
    >
        <div class="max-w-3xl">
            <h1
                data-hero-title
                data-intro
                class="text-display text-ink-strong mb-6 md:mb-8"
            >
                I build the systems between a measurement and <span data-cycle class="cycle"><span data-cycle-item>a <span class={accent}>decision</span>.</span>{outcomes.map(([article, word]) => (
                    <span data-cycle-item aria-hidden="true">{article} <span class={accent}>{word}</span>.</span>
                ))}</span>
            </h1>

            <p
                data-hero-fade
                data-intro
                class="text-lead text-ink drop-shadow-md mb-8 md:mb-10 max-w-measure"
            >
                Data platform engineer in Munich. Microsoft Fabric at work,
                containers and DuckDB at home, TouchDesigner after hours.
            </p>

            <div data-hero-fade data-intro class="flex pointer-events-auto">
                <a
                    href="/projects"
                    class="btn btn-primary"
                >
                    Projects
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll cue. Below md it sits in the hero's bottom padding, so it
         never overlaps the content on a short phone. -->
    <ScrollCue
        href="#now-building"
        label="Scroll to what I'm building now"
        data-scroll-cue
        data-intro
        class="absolute bottom-5 md:bottom-10 inset-x-0 mx-auto w-fit z-10"
    />
</section>

<style>
    /* The headline's last words: every phrase stacked in one grid cell, so
       the slot is as wide as the widest of them and a swap never re-wraps
       the headline. Only the first shows until home.ts takes over. */
    .cycle {
        display: inline-grid;
    }
    .cycle > * {
        grid-area: 1 / 1;
        white-space: nowrap;
    }
    .cycle > * + * {
        visibility: hidden;
    }
</style>
