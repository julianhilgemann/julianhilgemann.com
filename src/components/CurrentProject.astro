---
import LadderDiagram from "./LadderDiagram.astro";

// The figure's words restate the prose, so they stay out of
// literal markup (the llms generator would repeat them in the page docs).
const diagram = {
    deposits: { title: "Deposits", sub: ["placed by", "the optimiser"] },
    liquidity: { title: "Liquidity", sub: ["account balance,", "month by month"] },
    horizon: "Secured until",
    shortfall: "shortfall",
    units: { long: "months", short: "mo" },
    ariaLabel:
        "A deposit ladder at work: six fixed-term deposits of 6, 12 and 24 months as bars over 32 months, from January 2027 to August 2029. Below them the account balance falls a little every month and jumps each time a deposit is repaid, just as it nears zero. A flag marks August 2029 as the last month the plan covers.",
};
---

<section id="now-building" class="section border-t border-line-subtle scroll-mt-16">
    <div class="page-container">
        <h2 data-reveal-lines class="text-h2 text-ink-strong mb-head">Now building</h2>

        <div class="grid lg:grid-cols-12 gap-x-16 gap-y-8">
            <div data-reveal class="lg:col-span-5">
                <p class="badge mb-5">
                    <span class="badge-dot motion-safe:animate-pulse" aria-hidden="true"></span>
                    Live in the browser
                </p>
                <h3 class="text-3xl md:text-4xl font-bold tracking-tight text-ink-strong leading-tight">Liquiplan</h3>
                <p class="mt-5 text-lg md:text-xl text-ink leading-relaxed">
                    A planner for fixed-term deposits that answers one question:
                    how long will the money last, and which deposits, bought
                    when, make it last longest?
                </p>
            </div>

            <div data-reveal class="lg:col-span-7">
                <p class="text-lg text-ink-muted leading-relaxed">
                    Money that has to cover a monthly need is caught between two
                    mistakes. Left in an overnight account it earns little; locked
                    into fixed terms it may not be back when the month's
                    withdrawal is due. A deposit ladder staggers the maturities so
                    that each deposit returns just before its money is needed.
                    Liquiplan computes that ladder from the balances, the monthly
                    need and the offers at hand, and it takes its goals strictly
                    in order: first the last month that can still be covered,
                    then the wealth left at that month. Interest never costs a
                    month.
                </p>
                <ul class="mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm md:text-base text-ink">
                    <li class="flex items-start gap-3">
                        <svg class="shrink-0 mt-0.5 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                        The horizon first, interest second
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="shrink-0 mt-0.5 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                        An independent simulator checks every plan
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="shrink-0 mt-0.5 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                        One HTML file, and the numbers stay in the browser
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="shrink-0 mt-0.5 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                        Every decision can be replayed step by step
                    </li>
                </ul>
            </div>
        </div>

        <!-- The ladder at work, drawn from a plan the app computed: wide on desktop, compact on phones -->
        <div data-reveal class="mt-12 md:mt-16 -mx-4 sm:mx-0 panel px-3 py-6 sm:p-8 md:p-10">
            <LadderDiagram {...diagram} />
            <p class="mt-6 md:mt-8 text-xs md:text-sm text-ink-muted text-center text-balance">
                <svg class="inline-block align-[-1px] mr-1.5 text-info" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M0.6 2.2h7M4.2 6h8M8.4 9.8h9"></path></svg>
                Drawn from the app's own example: six deposits at illustrative
                rates. A model calculation, not financial advice.
            </p>
        </div>

        <!-- A <p>, not a div: the llms generator keeps link targets only inside
             paragraphs and list items, and both URLs should reach the docs. -->
        <p class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
            <a
                href="https://julianhilgemann.github.io/liquiplan-app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                Open the app
            </a>
            <a
                href="https://github.com/julianhilgemann/liquiplan-app"
                target="_blank"
                rel="noopener noreferrer"
                class="arrow-link justify-center"
            >
                Source and method on GitHub
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
            </a>
        </p>
    </div>
</section>
