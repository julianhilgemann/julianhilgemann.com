---
import MotionIntro from "../MotionIntro.astro";
---

<section
    id="hero"
    data-hero
    class="min-h-0 md:min-h-[100svh] py-28 md:py-0 flex flex-col justify-center relative isolate overflow-hidden"
>
    <MotionIntro />

    <!-- ========================================== -->
    <!-- LAYER 1: Interactive Blobs (Deepest)       -->
    <!-- ========================================== -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-40">
        <!-- Blob 1 (Top Right) -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] translate-x-1/3 -translate-y-1/4">
            <div class="w-full h-full md:will-change-transform" data-depth="0.05">
                <div class="w-full h-full bg-primary/20 rounded-full blur-[60px] md:blur-[140px] animate-blob"></div>
            </div>
        </div>

        <!-- Blob 2 (Bottom Left) -->
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] -translate-x-1/3 translate-y-1/3">
            <div class="w-full h-full md:will-change-transform" data-depth="0.08">
                <div class="w-full h-full bg-info/20 rounded-full blur-[50px] md:blur-[120px] animate-blob animation-delay-2000"></div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- LAYER 2: Canvas Particles (-z-30)          -->
    <!-- ========================================== -->
    <canvas data-hero-canvas data-intro class="absolute inset-0 w-full h-full pointer-events-none -z-30"></canvas>

    <!-- ========================================== -->
    <!-- LAYER 3: Global Glass Layer (-z-20)        -->
    <!-- Blurs the particles AND the blobs          -->
    <!-- ========================================== -->
    <div class="absolute inset-0 bg-background/20 backdrop-blur-[5px] pointer-events-none -z-20"></div>

    <!-- ========================================== -->
    <!-- LAYER 4: Content & Buttons (Top, z-10)     -->
    <!-- ========================================== -->
    <div
        data-hero-content
        class="w-full max-w-[1200px] mx-auto px-8 sm:px-12 lg:px-16 relative z-10 pointer-events-none"
    >
        <div class="max-w-3xl">
            <h1
                data-hero-title
                data-intro
                class="text-[2.625rem] sm:text-5xl md:text-7xl font-bold tracking-tight mb-6 md:mb-8 leading-[1.1]"
            >
                Aus Daten Werden <span class="whitespace-nowrap"
                    ><span
                        data-accent
                        class="inline-block tabular-nums text-transparent bg-clip-text bg-gradient-to-r from-primary to-yellow-300"
                        >Entscheidungen</span
                    >,</span
                > die zählen.
            </h1>

            <p
                data-hero-fade
                data-intro
                class="text-xl md:text-2xl text-text-primary drop-shadow-md mb-8 md:mb-10 leading-relaxed max-w-2xl"
            >
                <strong
                    >Power BI-Dashboards und Analytics-Landschaften, mit denen
                    Teams sofort arbeiten können.</strong
                >
                <br />
                <span class="text-lg md:text-xl text-text-secondary mt-2 block"
                    >Von unstrukturierten Rohdaten zu klaren KPIs, belastbaren
                    Zahlen und Entscheidungen die richtig sind.</span
                >
            </p>

            <div data-hero-fade data-intro class="flex flex-col sm:flex-row gap-4 pointer-events-auto">
                <a
                    href="/de/services"
                    data-magnetic
                    class="glass hover:bg-white/10 text-white font-medium py-3 px-6 rounded-full transition-colors border !border-primary text-center"
                >
                    Leistungen & Preise
                </a>
                <a
                    href="/de/about"
                    data-magnetic
                    class="glass hover:bg-white/10 text-white font-medium py-3 px-6 rounded-full transition-colors border border-white/10 text-center"
                >
                    Über mich
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll cue (desktop, where the hero fills the viewport) -->
    <a
        href="#current-project"
        data-scroll-cue
        data-intro
        aria-label="Zum aktuellen Projekt scrollen"
        class="hidden md:flex absolute bottom-10 inset-x-0 mx-auto w-10 h-16 items-start justify-center z-10 group"
    >
        <span class="relative block w-px h-14 bg-white/15 overflow-hidden group-hover:bg-white/30 transition-colors duration-300">
            <span class="scroll-cue-dot absolute left-0 top-0 w-px h-5 bg-gradient-to-b from-transparent to-primary"></span>
        </span>
    </a>
</section>

<style>
    @keyframes blob {
        0% {
            transform: translate(0, 0) scale(1);
        }
        33% {
            transform: translate(30px, -50px) scale(1.1);
        }
        66% {
            transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
            transform: translate(0, 0) scale(1);
        }
    }
    .animate-blob {
        animation: blob 7s infinite ease-in-out;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }

    @keyframes scroll-cue {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(300%);
        }
    }
    .scroll-cue-dot {
        animation: scroll-cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-blob,
        .scroll-cue-dot {
            animation: none;
        }
    }
</style>

