---
// "What I do" and "Selected work" on the homepage: the chain in three stages,
// then four tiles so the range is visible before anyone reads. Both get a
// screen of their own.
//
// "What I do" is the site's own argument in miniature — foundation, structure,
// surface — so each stage carries its specifics and a link to the proof rather
// than a two-word label. No counted figures: the cards describe the work, not
// its size, and no stack chips: the tools are named once, on /about. Markers
// travel as expressions: the llms generator flattens literal markup into the
// page docs, where they would read as duplicate copy. The card prose stays
// literal.
//
// Each tile is tagged with the Story chapter it belongs to, which is what
// keeps the homepage and the narrative pointing at each other, and drawn in
// that chapter's accent: blue for the system chapters, orange for the
// expressive end. The tiles only link out to work that exists; the expressive
// end is Datapipe, where a song's measurements drive the picture.
const chain = {
    markers: [
        { num: "01", name: "Foundation" },
        { num: "02", name: "Structure" },
        { num: "03", name: "Surface" },
    ],
};

const tiles = [
    {
        title: "FX Macro Data Platform",
        chapter: "Structure",
        tone: "info",
        note: "Macro time series kept by vintage, so every number can be traced back to what was knowable when it was published.",
        image: "/assets/fx_macro_platform.webp",
        href: "https://github.com/julianhilgemann/fx_macro_platform",
        external: true,
    },
    {
        title: "Interactive Yield Curve Heatmap",
        chapter: "Measurement",
        tone: "info",
        note: "Thirty years of the curve in one frame: colour carries the level, the shape carries the regime.",
        image: "/assets/interactive_yield_curve_app.webp",
        href: "https://julianhilgemann.github.io/yield_curve_heatmap_app/",
        external: true,
    },
    {
        title: "B2B Pipeline Forecasting",
        chapter: "Inference",
        tone: "info",
        note: "A forecast with its uncertainty attached, built to be argued with rather than believed.",
        image: "/assets/pipeline_forecast.webp",
        href: "https://github.com/julianhilgemann/hybrid_sales_pipeline_forecast",
        external: true,
    },
    {
        title: "Datapipe: Audio-reactive Shorts",
        chapter: "Expansion",
        tone: "primary",
        note: "A song measured frame by frame, then opened back up into light and motion. The same loop as the dashboards, run backwards.",
        image: "/assets/datapipe.webp",
        href: "https://github.com/julianhilgemann/audiovisual-animations",
        external: true,
    },
];
---

<!-- ── What I do: one chain, three stages ── -->
<!-- Tighter padding than a plain .section: the three cards have to share one screen with the heading. -->
<section id="what-i-do" class="section-screen py-16 md:py-20 border-t border-line-subtle">
    <div class="page-container">
        <div class="md:flex md:items-end md:justify-between md:gap-12 mb-8 md:mb-12">
            <h2 data-reveal-lines class="text-h2 text-ink-strong">What I do</h2>
            <p data-reveal class="mt-5 md:mt-0 md:text-right max-w-xl text-lg text-ink-muted leading-relaxed">
                One chain, three stages. A measurement has to land somewhere, be
                modelled into something that holds, and leave as a number someone
                can act on. I work across all three.
            </p>
        </div>

        <ol data-reveal-stagger class="what-chain grid gap-grid md:grid-cols-3">
            <li class="what-stage tone-info">
                <div class="what-card card card-hover spotlight-card">
                    <p class="eyebrow" aria-hidden="true">
                        <span class="eyebrow-num">{chain.markers[0].num}</span>
                        <span class="eyebrow-rule"></span>
                        {chain.markers[0].name}
                    </p>

                    <span class="icon-tile mt-5" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
                    </span>

                    <strong class="block mt-5 text-h3 text-ink-strong">Platforms</strong>
                    <p class="what-lead">Microsoft Fabric, run like a product.</p>
                    <p class="what-body">
                        A multi-tenant setup where every customer gets their own
                        Dev, Test and Prod on shared capacity. Changes go through
                        source files, Git and DevOps, so an environment can be
                        rebuilt rather than remembered.
                    </p>

                    <a href="/about#platform" class="what-link arrow-link">
                        How that runs today
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </li>

            <li class="what-stage tone-info">
                <div class="what-card card card-hover spotlight-card">
                    <p class="eyebrow" aria-hidden="true">
                        <span class="eyebrow-num">{chain.markers[1].num}</span>
                        <span class="eyebrow-rule"></span>
                        {chain.markers[1].name}
                    </p>

                    <span class="icon-tile mt-5" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"></path><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"></path></svg>
                    </span>

                    <strong class="block mt-5 text-h3 text-ink-strong">Data Warehousing</strong>
                    <p class="what-lead">Modelled once, so it can be reused.</p>
                    <p class="what-body">
                        Warehouses and lakehouses with real models: a named grain,
                        declared relationships, and lineage you can walk from a
                        dashboard figure back to its row. On Fabric today, on
                        Postgres and dbt before that.
                    </p>

                    <a
                        href="https://hyperadapted.com/story/?utm_source=julianhilgemann&utm_medium=referral&utm_campaign=julianhilgemann-site&utm_content=what-i-do#structure"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="what-link arrow-link"
                    >
                        The case for structure
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </li>

            <li class="what-stage tone-primary">
                <div class="what-card card card-hover spotlight-card">
                    <p class="eyebrow" aria-hidden="true">
                        <span class="eyebrow-num">{chain.markers[2].num}</span>
                        <span class="eyebrow-rule"></span>
                        {chain.markers[2].name}
                    </p>

                    <span class="icon-tile mt-5" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><rect x="7" y="12" width="3" height="6" rx="1"></rect><rect x="12.5" y="8" width="3" height="10" rx="1"></rect><rect x="18" y="4.5" width="3" height="13.5" rx="1"></rect></svg>
                    </span>

                    <strong class="block mt-5 text-h3 text-ink-strong">Business Intelligence</strong>
                    <p class="what-lead">The number people actually act on.</p>
                    <p class="what-body">
                        Dashboards, forecasts and scenario planning, over a metric
                        layer that holds still. A number is only worth acting on if
                        you can say what it leaves out, so the definitions and the
                        uncertainty travel with it.
                    </p>

                    <a href="/about#bi" class="what-link arrow-link">
                        Data products in fintech
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </li>
        </ol>

        <p data-reveal class="mt-7 md:mt-8 text-ink-muted leading-relaxed">
            And then the same chain backwards — a number opened back up into
            colour, motion and sound.
            <a href="https://hyperadapted.com/story/?utm_source=julianhilgemann&utm_medium=referral&utm_campaign=julianhilgemann-site&utm_content=what-i-do#expansion" target="_blank" rel="noopener noreferrer" class="text-link">That is the other half of the work.</a>
        </p>
    </div>
</section>

<!-- ── Selected work: the range, visible at a glance ── -->
<section class="section section-screen border-t border-line-subtle">
    <div class="page-container">
        <h2 data-reveal-lines class="text-h2 text-ink-strong mb-head">Selected work</h2>

        <ul data-reveal-stagger class="grid sm:grid-cols-2 gap-grid">
            {
                tiles.map((tile) => (
                    <li class={`tone-${tile.tone}`}>
                        <a
                            href={tile.href}
                            target={tile.external ? "_blank" : undefined}
                            rel={tile.external ? "noopener noreferrer" : undefined}
                            class="card card-hover spotlight-card p-0 group block overflow-hidden h-full"
                        >
                            <span class="block relative aspect-[16/9] overflow-hidden bg-wash-subtle">
                                <img
                                    src={tile.image}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-slow"
                                />
                            </span>
                            <span class="block p-card">
                                <span class="eyebrow eyebrow-tone">{tile.chapter}</span>
                                <strong class="block text-h3 text-ink-strong mt-3 mb-2">
                                    {tile.title}
                                </strong>
                                <span class="block text-ink-muted leading-relaxed">{tile.note}</span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <p class="mt-10">
            <a href="/projects" class="arrow-link">
                All projects
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg
                >
            </a>
        </p>
    </div>
</section>

<style>
    /* ── What I do ──
       Three stages of one chain, built from the shared card, eyebrow and
       icon tile (design-system/components.css). The stage's tone says
       which end of the chain it sits at, and hovering one stage dims the
       others, so the section answers the pointer instead of sitting still. */
    .what-stage {
        display: flex;
        flex-direction: column;
    }

    .what-card {
        display: flex;
        flex-direction: column;
        flex: 1;
        /* .card-hover's list plus opacity, for the dimming below. */
        transition:
            opacity var(--dur-base) var(--ease-out),
            background-color var(--dur-base) var(--ease-out),
            border-color var(--dur-base) var(--ease-out),
            translate var(--dur-base) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        /* `:has`, not `.what-chain:hover`, or the gaps between the cards
           would dim all three on the way past. */
        .what-chain:has(.what-stage:hover) .what-stage:not(:hover) .what-card {
            opacity: 0.5;
        }
    }

    .what-lead {
        margin-top: 0.5rem;
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.5;
        color: rgb(var(--color-ink));
    }

    .what-body {
        margin-top: 0.75rem;
        line-height: 1.7;
        color: rgb(var(--color-ink-muted));
    }

    /* `auto` keeps the three links on one line across the row, however much
       prose sits above them. */
    .what-link {
        align-self: flex-start;
        margin-top: auto;
        padding-top: 1.25rem;
        font-size: 0.9rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .what-card {
            transition: none;
        }
    }
</style>
