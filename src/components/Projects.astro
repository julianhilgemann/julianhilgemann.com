---
import ProjectCard from "./ProjectCard.astro";

// The first link is where the card itself leads: the live app when there is
// one, the repository otherwise.
const projects = [
    {
        title: "FX Macro Data Platform",
        category: "Point-in-Time Data Platform",
        description:
            "A platform for macro and FX time series that keeps every vintage, so each number traces back to what was knowable when it was published.",
        image: "/assets/fx_macro_platform.webp",
        links: [
            { kind: "github", href: "https://github.com/julianhilgemann/fx_macro_platform", label: "GitHub" },
        ],
    },
    {
        title: "Vantage Alpin: Analytics Engineering",
        category: "Production Data Stack",
        description:
            "Production financial reporting engine replacing legacy PDF reports with a dynamic, decision-ready Power BI system.",
        image: "/assets/vantage_dashboard_main.webp",
        links: [
            { kind: "github", href: "https://github.com/julianhilgemann/BI-Pipeline/blob/main/README.md", label: "GitHub" },
            { kind: "video", href: "https://www.youtube.com/watch?v=QGwda9UsQHg", label: "YouTube" },
        ],
    },
    {
        title: "Datapipe: Audio-reactive Shorts",
        category: "Audio-reactive Video",
        description:
            "One command turns a song into a finished YouTube Short: the music is measured frame by frame, and the measurements drive a neon tunnel rendered headless in Blender.",
        image: "/assets/datapipe.webp",
        links: [
            { kind: "github", href: "https://github.com/julianhilgemann/audiovisual-animations", label: "GitHub" },
        ],
    },
    {
        title: "End-to-End SaaS Operating System",
        category: "Stochastic Financial Twin",
        description:
            "A full-stack simulation engine that translates static business plans into living data systems.",
        image: "/assets/agentic_hla.webp",
        links: [
            { kind: "github", href: "https://github.com/julianhilgemann/Portfolio/blob/main/README.md", label: "GitHub" },
        ],
    },
    {
        title: "Interactive Yield Curve Heatmap",
        category: "Data Visualization",
        description:
            "An interactive web application encoding 25+ years of German sovereign yield curve data into a single, high-performance canvas heatmap.",
        image: "/assets/interactive_yield_curve_app.webp",
        links: [
            { kind: "live", href: "https://julianhilgemann.github.io/yield_curve_heatmap_app/", label: "Live app" },
            { kind: "github", href: "https://github.com/julianhilgemann/heatmapp", label: "GitHub" },
        ],
    },
    {
        title: "B2B Pipeline Forecasting Prototype",
        category: "Predictive Analytics",
        description:
            "Business-day sales pipeline forecasting prototype with competing outcomes, age-based conversion kernel estimation, and PIT reconstruction.",
        image: "/assets/pipeline_forecast.webp",
        links: [
            { kind: "github", href: "https://github.com/julianhilgemann/pipeline-forecast", label: "GitHub" },
        ],
    },
    {
        title: "ShaderGradient Playground",
        category: "Creative Coding & Graphics",
        description:
            "A browser-based, real-time shader gradient simulator built on Three.js and custom GLSL for rendering and exporting animating mesh gradients.",
        image: "/assets/shadergradient.webp",
        links: [
            { kind: "live", href: "https://julianhilgemann.github.io/shader_gradient_app/", label: "Live app" },
            { kind: "github", href: "https://github.com/julianhilgemann/shadergradient", label: "GitHub" },
        ],
    },
] as const;

// Featured cards lead the list and span the grid, image beside the text.
const FEATURED = 3;
---

<!-- The card list only; the Projects page supplies the heading. The first
     three cards are featured and span both columns, so seven cards fill the
     grid evenly. Cards rise one by one as they scroll in ([data-reveal-batch],
     src/scripts/motion.ts). -->
<ul data-reveal-batch class="grid sm:grid-cols-2 gap-grid">
    {
        projects.map((project, i) => (
            <li class:list={[i < FEATURED && "sm:col-span-2"]}>
                <ProjectCard {...project} links={[...project.links]} featured={i < FEATURED} />
            </li>
        ))
    }
</ul>
