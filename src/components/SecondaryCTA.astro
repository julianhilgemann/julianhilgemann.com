---
// The contact screen that closes the homepage, Projects and About: one
// line, one orbiting button, over the gradient sheet. The sheet sits at 80%
// over the page colour, the same veil the hero's glass layer gives it, and
// melts into the page at its top and bottom edges.
import GradientSheet from "./GradientSheet.astro";
---

<section class="section section-screen relative isolate overflow-hidden">
    <GradientSheet start={22} fade class="-z-10 opacity-80" />

    <div class="page-container text-center">
        <h2 data-reveal-lines class="text-h2 text-ink-strong mb-8">
            Questions? I reply fast.
        </h2>
        <div data-reveal>
            <a
                href="#"
                class="btn btn-primary orbit-ring js-open-contact"
                data-location="secondary-cta"
            >
                Contact me
            </a>
        </div>
    </div>
</section>
