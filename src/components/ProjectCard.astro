---
// One project on /projects: the homepage's "Selected work" tile (image,
// label, title, a sentence) plus where it leads. The first link is the
// card's own destination, so the whole card answers a click; a second one
// (the repository next to a live app, say) sits beside it, above that.
//
//   featured  spans the grid's two columns, image beside the text from lg
type LinkKind = "github" | "live" | "video";

interface Props {
    title: string;
    category: string;
    description: string;
    image: string;
    links: { kind: LinkKind; href: string; label: string }[];
    featured?: boolean;
}

const { title, category, description, image, links, featured = false } = Astro.props;
---

<article
    class:list={[
        "card card-hover spotlight-card p-0 group flex flex-col overflow-hidden h-full",
        featured && "lg:flex-row",
    ]}
>
    <span
        class:list={[
            "block relative aspect-[16/9] overflow-hidden bg-wash-subtle shrink-0",
            featured && "lg:w-1/2",
        ]}
    >
        <img
            src={image}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-slow"
        />
    </span>

    <div class:list={["flex flex-col flex-1 p-card", featured && "lg:p-10"]}>
        <p class="eyebrow eyebrow-tone">{category}</p>
        <h3 class="text-h3 text-ink-strong mt-3 mb-2">{title}</h3>
        <p class="text-ink-muted leading-relaxed">{description}</p>

        <p class="project-links">
            {
                links.map((link, i) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={["project-link", i === 0 && "is-primary"]}
                    >
                        {link.kind === "github" && (
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58l-.01-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.67 1.65.25 2.87.12 3.17.78.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.69.82.57A12 12 0 0 0 12 .297z" /></svg>
                        )}
                        {link.kind === "live" && (
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                        )}
                        {link.kind === "video" && (
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33zM9.75 15.02V8.48l5.75 3.27-5.75 3.27z" /></svg>
                        )}
                        {link.label}
                        <svg class="project-link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                    </a>
                ))
            }
        </p>
    </div>
</article>

<style>
    /* Pushed to the foot of the card, so the links line up across a row. */
    .project-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        margin-top: auto;
        padding-top: 1.5rem;
    }

    .project-link {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9375rem;
        font-weight: 500;
        color: rgb(var(--color-ink-muted));
        transition: color var(--dur-fast) var(--ease-out);
    }

    .project-link:hover,
    .project-link.is-primary {
        color: rgb(var(--color-ink));
    }

    /* The first link covers the whole card; the others sit above it. */
    .project-link.is-primary {
        position: static;
    }
    .project-link.is-primary::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    .project-link-arrow {
        color: rgb(var(--tone));
        transition: translate var(--dur-base) var(--ease-out);
    }

    .project-link:hover .project-link-arrow,
    .group:hover .is-primary .project-link-arrow {
        translate: 2px -2px;
    }

    @media (hover: hover) and (pointer: fine) {
        .group:hover .project-link.is-primary {
            color: rgb(var(--tone));
        }
        .group:has(.project-link:not(.is-primary):hover) .project-link.is-primary {
            color: rgb(var(--color-ink));
        }
        .project-link:not(.is-primary):hover {
            color: rgb(var(--tone));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-link-arrow {
            transition: none;
        }
    }
</style>
