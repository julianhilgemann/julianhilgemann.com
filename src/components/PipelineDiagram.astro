---
// High-level architecture of the current project: public APIs → immutable raw
// landing → transformations against a warehouse → dashboards, research and an
// API, with an orchestrator driving the first three and every stage running in
// its own container. System shape, not tech detail.
//
// Two layouts of the same drawing: wide (lg+, left → right) and tall (phones,
// iPad portrait, top → bottom). The markup is the static end state — what
// reduced-motion and no-JS visitors see. src/scripts/pipeline-diagram.ts
// builds it in on scroll and runs the data flow.
//
// All text arrives through props so the llms generator (which flattens
// literal markup) never picks it up; the section's prose carries the meaning.
interface Stage {
    title: string;
    lines: string[];
}
interface Props {
    stages: Stage[];
    orchestration: { title: string; sub: string };
    ariaLabel: string;
}

const { stages, orchestration, ariaLabel } = Astro.props;
const kinds = ["sources", "raw", "transform", "insight"] as const;

// ── geometry ──────────────────────────────────────────────────────────────
// Stage art is drawn once in a local 140 × 90 box and placed per layout.
type Box = { x: number; y: number };
interface Layout {
    id: "wide" | "tall";
    viewBox: string;
    class: string;
    box: { w: number; h: number };
    boxes: Box[];
    art: (b: Box) => string;
    title: (b: Box) => { x: number; y: number };
    desc: (b: Box) => { x: number; y: number; step: number; anchor: string };
    flows: Array<[number, number, number, number]>;
    rail: [number, number, number, number];
    ties: Array<[number, number, number, number]>;
    label: { x: number; y: number };
}

const WIDE_Y = 110;
const wideXs = [20, 300, 580, 860];
const TALL_X = 48;
const tallYs = [42, 222, 402, 582];

const layouts: Layout[] = [
    {
        id: "wide",
        viewBox: "0 0 1050 315",
        class: "hidden lg:block w-full h-auto",
        box: { w: 170, h: 150 },
        boxes: wideXs.map((x) => ({ x, y: WIDE_Y })),
        art: (b) => `translate(${b.x + 15} ${b.y + 46})`,
        title: (b) => ({ x: b.x + 16, y: b.y + 28 }),
        desc: (b) => ({ x: b.x + 85, y: b.y + 176, step: 18, anchor: "middle" }),
        flows: [0, 1, 2].map((i) => [wideXs[i] + 170, 201, wideXs[i + 1], 201]),
        rail: [105, 62, 665, 62],
        ties: [0, 1, 2].map((i) => [wideXs[i] + 85, 62, wideXs[i] + 85, WIDE_Y]),
        label: { x: 20, y: 40 },
    },
    {
        id: "tall",
        viewBox: "0 0 420 716",
        class: "lg:hidden w-full h-auto max-w-[440px] md:max-w-[540px] mx-auto",
        box: { w: 360, h: 124 },
        boxes: tallYs.map((y) => ({ x: TALL_X, y })),
        art: (b) => `translate(${b.x + 14} ${b.y + 20}) scale(0.85)`,
        title: (b) => ({ x: b.x + 151, y: b.y + 46 }),
        desc: (b) => ({ x: b.x + 151, y: b.y + 74, step: 21, anchor: "start" }),
        flows: [0, 1, 2].map((i) => [122, tallYs[i] + 124, 122, tallYs[i + 1]]),
        rail: [20, 104, 20, 464],
        ties: [0, 1, 2].map((i) => [20, tallYs[i] + 62, TALL_X, tallYs[i] + 62]),
        label: { x: 20, y: 24 },
    },
];

// ── art helpers ───────────────────────────────────────────────────────────
const polar = (cx: number, cy: number, r: number, a: number) =>
    `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`;
function gearPath(cx: number, cy: number, outer: number, inner: number, teeth: number, hole: number) {
    const step = (Math.PI * 2) / teeth;
    const pts: string[] = [];
    for (let i = 0; i < teeth; i++) {
        const a = i * step;
        pts.push(
            polar(cx, cy, inner, a),
            polar(cx, cy, outer, a + step * 0.18),
            polar(cx, cy, outer, a + step * 0.48),
            polar(cx, cy, inner, a + step * 0.66),
        );
    }
    const ring = `M${cx + hole},${cy} A${hole},${hole} 0 1 0 ${cx - hole},${cy} A${hole},${hole} 0 1 0 ${cx + hole},${cy} Z`;
    return `M${pts.join("L")}Z ${ring}`;
}
const bigGear = gearPath(34, 46, 26, 20.5, 10, 7);
const smallGear = gearPath(67, 22, 17, 12.5, 7, 4.5);

const scatter = [
    [104, 70],
    [110, 62],
    [115, 66],
    [120, 52],
    [125, 56],
    [129, 44],
    [134, 40],
    [137, 30],
];
const bars = [18, 30, 24, 38, 28];
const PACKETS = 4;
---

<figure data-pipeline role="img" aria-label={ariaLabel} class="pipeline">
    {
        layouts.map((L) => (
            <svg data-layout={L.id} viewBox={L.viewBox} class={L.class} aria-hidden="true">
                {/* Orchestration rail with ties down (or across) to the stages it drives */}
                <g data-orchestration>
                    <text x={L.label.x} y={L.label.y} class={`pipe-rail-label pipe-rail-label-${L.id}`}>
                        <tspan class="pipe-rail-title">{orchestration.title.toUpperCase()}</tspan>
                        <tspan dx="10">{orchestration.sub}</tspan>
                    </text>
                    <line data-rail x1={L.rail[0]} y1={L.rail[1]} x2={L.rail[2]} y2={L.rail[3]} class="pipe-rail" />
                    {L.ties.map(([x1, y1, x2, y2]) => (
                        <line data-tie x1={x1} y1={y1} x2={x2} y2={y2} class="pipe-tie" />
                    ))}
                    <circle cx={L.rail[0]} cy={L.rail[1]} r="4.5" class="pipe-rail-node" />
                    <circle data-rail-pulse cx={L.rail[0]} cy={L.rail[1]} r="3.5" class="pipe-rail-pulse" />
                </g>

                {/* Flows between stages */}
                {L.flows.map(([x1, y1, x2, y2]) => (
                    <g data-flow data-from={`${x1},${y1}`} data-to={`${x2},${y2}`}>
                        <line x1={x1} y1={y1} x2={x2} y2={y2} class="pipe-flow" />
                        <path
                            d={
                                L.id === "wide"
                                    ? `M${x2 - 7},${y2 - 5} L${x2 - 1},${y2} L${x2 - 7},${y2 + 5}`
                                    : `M${x2 - 5},${y2 - 7} L${x2},${y2 - 1} L${x2 + 5},${y2 - 7}`
                            }
                            class="pipe-flow-head"
                        />
                    </g>
                ))}

                {/* Stages */}
                {L.boxes.map((b, i) => (
                    <g data-stage={kinds[i]}>
                        <g data-stage-inner>
                            <rect x={b.x} y={b.y} width={L.box.w} height={L.box.h} rx="14" class="pipe-box" data-stage-box />
                            {/* container glyph: every stage is its own container */}
                            <g transform={`translate(${b.x + L.box.w - 32} ${b.y + 14})`} class="pipe-container">
                                <rect width="18" height="12" rx="2" />
                                <line x1="4.5" y1="2.5" x2="4.5" y2="9.5" />
                                <line x1="9" y1="2.5" x2="9" y2="9.5" />
                                <line x1="13.5" y1="2.5" x2="13.5" y2="9.5" />
                            </g>
                            <text x={L.title(b).x} y={L.title(b).y} class={`pipe-title pipe-title-${L.id}`}>
                                {stages[i].title.toUpperCase()}
                            </text>
                            {stages[i].lines.map((line, n) => {
                                const d = L.desc(b);
                                return (
                                    <text x={d.x} y={d.y + n * d.step} text-anchor={d.anchor} class={`pipe-desc pipe-desc-${L.id}`}>
                                        {line}
                                    </text>
                                );
                            })}

                            <g transform={L.art(b)}>
                                {kinds[i] === "sources" && (
                                    <>
                                        {[2, 34, 66].map((y) => (
                                            <path d={`M78,${y + 11} C108,${y + 11} 112,45 140,45`} class="pipe-wire" />
                                        ))}
                                        {[2, 34, 66].map((y) => (
                                            <g transform={`translate(0 ${y})`}>
                                                <rect width="78" height="22" rx="11" class="pipe-pill" />
                                                <circle data-api-led cx="13" cy="11" r="3.5" class="pipe-led" />
                                                <text x="26" y="15" class="pipe-mono">API</text>
                                            </g>
                                        ))}
                                    </>
                                )}

                                {kinds[i] === "raw" && (
                                    <>
                                        <rect x="30" y="16" width="56" height="66" rx="5" class="pipe-sheet pipe-sheet-back" />
                                        <rect x="40" y="9" width="56" height="66" rx="5" class="pipe-sheet pipe-sheet-mid" />
                                        <rect data-sheet-front x="50" y="2" width="56" height="66" rx="5" class="pipe-sheet pipe-sheet-front" />
                                        <rect x="58" y="12" width="30" height="3" rx="1.5" class="pipe-line" />
                                        <rect x="58" y="21" width="38" height="3" rx="1.5" class="pipe-line" />
                                        <rect x="58" y="30" width="24" height="3" rx="1.5" class="pipe-line" />
                                        <rect x="58" y="44" width="36" height="13" rx="3" class="pipe-hash" />
                                        <text x="76" y="53.5" text-anchor="middle" class="pipe-hash-text">#a3f9</text>
                                        <text data-vintage x="116" y="86" text-anchor="middle" class="pipe-mono pipe-vintage">v1284</text>
                                    </>
                                )}

                                {kinds[i] === "transform" && (
                                    <>
                                        <path data-gear="big" d={bigGear} fill-rule="evenodd" class="pipe-gear" />
                                        <path data-gear="small" d={smallGear} fill-rule="evenodd" class="pipe-gear pipe-gear-small" />
                                        <path d="M96,28 L96,72 A20,6 0 0 0 136,72 L136,28" class="pipe-db" />
                                        <ellipse cx="116" cy="28" rx="20" ry="6" class="pipe-db pipe-db-top" />
                                        {[36, 49, 62].map((y) => (
                                            <rect data-db-row x="100" y={y} width="32" height="7" rx="2" class="pipe-db-row" />
                                        ))}
                                    </>
                                )}

                                {kinds[i] === "insight" && (
                                    <>
                                        <rect x="0" y="6" width="86" height="80" rx="6" class="pipe-panel" />
                                        {[8, 14, 20].map((x) => (
                                            <circle cx={x} cy="14" r="1.6" class="pipe-panel-dot" />
                                        ))}
                                        <polyline points="10,38 22,33 34,35 46,27 58,30 70,22 78,24" class="pipe-spark" />
                                        {bars.map((h, n) => (
                                            <rect
                                                data-bar={n === bars.length - 1 ? "live" : undefined}
                                                x={10 + n * 14}
                                                y={78 - h}
                                                width="9"
                                                height={h}
                                                rx="1.5"
                                                class={n === bars.length - 1 ? "pipe-bar pipe-bar-live" : "pipe-bar"}
                                            />
                                        ))}
                                        <path d="M98,20 L98,80 L142,80" class="pipe-axis" />
                                        <line x1="101" y1="74" x2="140" y2="28" class="pipe-fit" />
                                        {scatter.map(([x, y]) => (
                                            <circle data-dot cx={x} cy={y} r="2.2" class="pipe-dot" />
                                        ))}
                                    </>
                                )}
                            </g>
                        </g>
                    </g>
                ))}

                {/* Data packets, parked until the flow starts */}
                {Array.from({ length: PACKETS }, () => (
                    <g data-packet class="pipe-packet">
                        <circle r="9" class="pipe-packet-glow" />
                        <circle r="4" class="pipe-packet-core" />
                    </g>
                ))}
            </svg>
        ))
    }
</figure>

