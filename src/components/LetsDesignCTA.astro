---
// Closing screen of /services. Same shape as SecondaryCTA (heading, one
// orbiting contact button), with a sentence of its own.
---

<section
    id="cta-section"
    class="section section-screen relative isolate overflow-hidden border-t border-line-subtle"
>
    <div class="page-container text-center">
        <h2 class="text-h2 text-ink-strong mb-6">
            Let’s design your decision system.
        </h2>
        <p class="text-lead text-ink-muted mb-10 max-w-measure mx-auto">
            If your company has data but decisions still rely on gut feeling, we
            should talk.
        </p>
        <a
            href="#"
            class="btn btn-primary orbit-ring js-open-contact"
            data-location="lets-design-cta"
        >
            Schedule Consultation
        </a>
    </div>
</section>
