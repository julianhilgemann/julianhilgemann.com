---
const { lang = "en" } = Astro.props;

interface NavItem {
    name: string;
    href: string;
}

// One list: the site is English. `lang` survives only for the legal pages,
// which German law wants in German and which LayoutDE still renders.
const navItems: NavItem[] = [
    { name: "Home", href: "/" },
    { name: "Story", href: "/story" },
    { name: "Projects", href: "/projects" },
    { name: "Work", href: "/work" },
    { name: "Services", href: "/services" },
];

const contactText = lang === "de" ? "Kontakt" : "Contact";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
    // Exact match for the home page, prefix match for everything else
    if (href === "/") {
        return currentPath === href;
    }
    return currentPath.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-50 pointer-events-none">
    <!-- Main Navbar Container -->
    <div
        class="glass mx-auto mt-4 w-[calc(100%-2rem)] max-w-[1200px] rounded-[32px] px-4 py-3 md:px-6 md:py-3 flex items-center justify-between pointer-events-auto shadow-sm relative z-50 transition-colors duration-300"
        id="navbar-container"
    >
        <!-- Logo Area -->
        <div class="flex flex-1 justify-start z-50">
            <a
                href="/"
                class="font-bold tracking-tight hover:text-primary transition-colors duration-300 ease-in-out shrink-0"
            >
                <span class="text-lg">Julian Hilgemann</span>
            </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center shrink-0 relative z-50">
            {
                navItems.map((item, i) => (
                    <>
                        {i > 0 && <span class="w-px h-3 bg-white/10 block mx-3 lg:mx-5" aria-hidden="true" />}
                        <a
                            href={item.href}
                            class:list={[
                                "text-sm font-medium transition-colors duration-300 ease-in-out",
                                isActive(item.href) ? "text-primary" : "text-white hover:text-primary",
                            ]}
                        >
                            {item.name}
                        </a>
                    </>
                ))
            }
        </nav>

        <!-- Right Side: Lang & Desktop Contact & Mobile Toggle -->
        <div class="flex flex-1 justify-end items-center gap-4 z-50">
            <!-- Desktop Contact CTA -->
            <a
                href="#"
                class="orbit-ring hidden md:inline-flex glass hover:bg-white/10 text-white text-sm font-medium py-2 px-4 rounded-full transition-colors duration-300 ease-in-out border !border-primary text-center whitespace-nowrap js-open-contact"
                data-location="header-cta"
            >
                {contactText}
            </a>

            <!-- Mobile Menu Toggle Button -->
            <button
                id="mobile-menu-toggle"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-full border border-white/10 hover:border-white/20 transition-colors relative"
                aria-label="Toggle Menu"
            >
                <div
                    class="relative w-[18px] h-[14px] flex flex-col justify-between text-white"
                    id="nav-toggle-icon"
                >
                    <span
                        class="w-full h-[2px] bg-current rounded-full transition-all duration-300 origin-center"
                        id="nav-line-1"></span>
                    <span
                        class="w-full h-[2px] bg-current rounded-full transition-all duration-300 origin-center"
                        id="nav-line-2"></span>
                    <span
                        class="w-full h-[2px] bg-current rounded-full transition-all duration-300 origin-center"
                        id="nav-line-3"></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
        id="mobile-menu"
        class="fixed inset-x-0 bottom-0 top-[4.5rem] p-4 pointer-events-none z-40"
    >
        <div
            class="glass flex flex-col items-center bg-[#0d1527] w-full h-full rounded-3xl overflow-hidden transition-all duration-[400ms] ease-[cubic-bezier(0.25,1,0.5,1)] origin-top opacity-0 scale-y-0"
            id="mobile-menu-inner"
        >
            <nav
                class="flex flex-col w-full py-6 px-4 gap-6 pointer-events-auto max-w-sm mx-auto"
            >
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class:list={[
                                "text-2xl font-medium text-center transition-colors duration-300 nav-link-mobile",
                                isActive(item.href)
                                    ? "text-primary"
                                    : "text-white hover:text-primary",
                            ]}
                        >
                            {item.name}
                        </a>
                    ))
                }

                <hr class="border-white/10 w-full my-2" />

                <div class="flex flex-col items-center gap-4 w-full">
                    <a
                        href="#"
                        class="glass hover:bg-white/10 text-white text-lg font-medium py-3 px-8 rounded-full transition-all duration-300 border !border-primary text-center w-full js-open-contact nav-link-mobile"
                        data-location="mobile-menu-cta"
                    >
                        {contactText}
                    </a>

                </div>
            </nav>
        </div>
    </div>
</header>

<script>
    const setupMobileMenu = () => {
        const toggle = document.getElementById("mobile-menu-toggle");
        const menu = document.getElementById("mobile-menu");
        const menuInner = document.getElementById("mobile-menu-inner");
        const iconElement = document.getElementById("nav-toggle-icon");
        const line1 = document.getElementById("nav-line-1");
        const line2 = document.getElementById("nav-line-2");
        const line3 = document.getElementById("nav-line-3");
        const navbarContainer = document.getElementById("navbar-container");
        const body = document.body;

        if (
            !toggle ||
            !menu ||
            !menuInner ||
            !iconElement ||
            !navbarContainer ||
            !line1 ||
            !line2 ||
            !line3
        )
            return;

        let isOpen = false;

        const closeMenu = () => {
            if (!isOpen) return;
            isOpen = false;

            // Icon animation back to hamburger
            iconElement.classList.remove("!text-primary");
            line1.classList.remove("translate-y-[6px]", "rotate-45");
            line2.classList.remove("opacity-0");
            line3.classList.remove("-translate-y-[6px]", "-rotate-45");

            // Menu animation out
            menuInner.classList.remove("opacity-100", "scale-y-100");
            menuInner.classList.add("opacity-0", "scale-y-0");

            // Remove scroll lock
            body.style.overflow = "";

            // Make menu unclickable after animation
            setTimeout(() => {
                if (!isOpen) menu.classList.add("pointer-events-none");
            }, 300);
        };

        const openMenu = () => {
            if (isOpen) return;
            isOpen = true;

            // Icon animation to X and change color
            iconElement.classList.add("!text-primary");
            line1.classList.add("translate-y-[6px]", "rotate-45");
            line2.classList.add("opacity-0");
            line3.classList.add("-translate-y-[6px]", "-rotate-45");

            // Menu animation in
            menu.classList.remove("pointer-events-none");
            // small delay to ensure display block is applied before animating
            requestAnimationFrame(() => {
                menuInner.classList.remove("opacity-0", "scale-y-0");
                menuInner.classList.add("opacity-100", "scale-y-100");
            });

            // Add scroll lock
            body.style.overflow = "hidden";
        };

        const toggleMenu = (e: Event) => {
            e.stopPropagation();
            if (isOpen) {
                closeMenu();
            } else {
                openMenu();
            }
        };

        toggle.addEventListener("click", toggleMenu);

        // Close menu on click outside
        document.addEventListener("click", (e) => {
            if (
                isOpen &&
                !menuInner.contains(e.target as Node) &&
                !toggle.contains(e.target as Node)
            ) {
                closeMenu();
            }
        });

        // Handle escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && isOpen) {
                closeMenu();
            }
        });

        // Close menu when clicking a link
        const navLinks = document.querySelectorAll(".nav-link-mobile");
        navLinks.forEach((link) => {
            link.addEventListener("click", () => {
                // If it's a contact button, the modal script will handle the opening, we just need to close the menu
                closeMenu();
            });
        });
    };

    // Run on load
    setupMobileMenu();
    // Run on astro page swap
    document.addEventListener("astro:page-load", setupMobileMenu);
</script>
